#include <iostream>
using namespace std;

int sumPrimeFactors(int n) {
    int sum = 0;
    for (int p = 2; p * p <= n; p++) {
        while (n % p == 0) {
            sum += p;
            n /= p;
        }
    }
    if (n > 1) {     
        sum += n;
    }
    return sum;
}

int smallestValue(int n) {
    while (true) {
        int next = sumPrimeFactors(n);
        if (next == n) {
            return n;
        }
        n = next;
    }
}

int main() {
    int n;
    cin >> n;
    cout << smallestValue(n) << endl;
    return 0;
}
